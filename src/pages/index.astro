---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const songs = (await getCollection('songs')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'es', { sensitivity: 'base' })
);
const artists = [...new Set(songs.map(song => song.data.artist))].sort((a,b) =>
  a.localeCompare(b, 'es', { sensitivity: 'base' })
);
const publishedLists = (await getCollection('lists')).map(list => ({
  id: list.id, name: list.data.title,
  description: list.data.description || '', songIds: list.data.songs
})).sort((a,b) => a.name.localeCompare(b.name, 'es'));
const searchIndex = songs.map(song => ({
  id: song.id, title: song.data.title, artist: song.data.artist,
  language: song.data.language || '', tags: song.data.tags || [], body: song.body || ''
}));
---
<BaseLayout>
<header class="topbar">
  <a class="brand" href={base} aria-label="Cantario, inicio">
    <img src={base + 'icon.svg'} alt="" width="42" height="42" />
    <span class="brand-copy"><strong>cantario<span class="brand-dot">.</span></strong><small>tu cancionero vivo</small></span>
  </a>
  <div class="topbar-actions"><span id="connection" class="connection" title="Estado de conexión" aria-live="polite"><span aria-hidden="true">●</span> <span class="connection-label">Tu biblioteca, siempre cerca</span></span></div>
</header>
<main>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-shape hero-shape-one" aria-hidden="true"></div><div class="hero-shape hero-shape-two" aria-hidden="true"></div>
    <span class="eyebrow">UN LUGAR PARA CANTAR</span>
    <h1 id="hero-title">Tus canciones,<br /><em>siempre con vos.</em></h1>
    <p>Un hogar para las canciones que nos acompañan. Abrí, leé, cantá. Incluso sin internet.</p>
    <div class="hero-footer">
      <span class="hero-stat"><strong>{songs.length}</strong> {songs.length === 1 ? 'canción' : 'canciones'}</span>
      <span class="hero-separator"></span>
      <span class="hero-stat"><strong>{artists.length}</strong> {artists.length === 1 ? 'artista' : 'artistas'}</span>
    </div>
  </section>
  <section class="list-hub" aria-labelledby="lists-heading">
    <div class="section-header"><div><span class="eyebrow eyebrow-olive">ORGANIZÁ TUS CANCIONES</span><h2 id="lists-heading">Mis listas</h2></div></div>
    <p class="list-intro">Para cada círculo, encuentro o momento. La misma canción puede vivir en varias listas.</p>
    <div class="lists-category"><strong>PERSONALES · ESTE DISPOSITIVO</strong><small>Se pueden modificar incluso sin internet.</small></div>
    <form id="new-list-form" class="create-list-form">
      <label for="new-list-name" class="sr-only">Nombre de la nueva lista</label>
      <input id="new-list-name" name="name" required maxlength="60" placeholder="Nombre de una nueva lista…" />
      <button type="submit" class="create-list-button">+ Crear lista</button>
    </form>
    <div id="personal-list-grid" class="lists-grid"></div>
    <p id="local-list-empty" class="list-hint">Todavía no tenés listas personales. Creá una y agregá canciones desde la biblioteca.</p>
    {publishedLists.length > 0 && <section aria-labelledby="published-list-heading" class="published-list-section">
      <div class="lists-category"><strong id="published-list-heading">LISTAS PUBLICADAS</strong><small>Compartidas desde Pages CMS en todos tus dispositivos.</small></div>
      <div class="lists-grid">{publishedLists.map(list => <div class="list-tile">
        <button class="list-tile-main" type="button" data-published-list={list.id} data-list-name={list.name} data-song-ids={list.songIds.join(',')} title={'Ver lista ' + list.name}>
          <strong>{list.name}</strong><small>{list.songIds.length} {list.songIds.length === 1 ? 'canción' : 'canciones'}</small>
          {list.description && <span class="published-list-description">{list.description}</span>}
        </button>
        <span class="published-label">CMS</span>
      </div>)}</div>
    </section>}
    <p id="lists-feedback" class="list-feedback" role="status" aria-live="polite"></p>
  </section>
  <section class="library" aria-label="Biblioteca de canciones">
    <div class="section-header"><div><span class="eyebrow eyebrow-olive">TU BIBLIOTECA</span><h2>El cancionero</h2></div>
      <a class="editor-link" href="https://app.pagescms.org/" target="_blank" rel="noopener noreferrer">Gestionar letras <span aria-hidden="true">↗</span></a>
    </div>
    <div class="search-bar">
      <span class="search-icon" aria-hidden="true">⌕</span>
      <label class="sr-only" for="search">Buscar canciones, artistas o letras</label>
      <input id="search" type="search" placeholder="Buscar canción, artista o letra…" autocomplete="off" />
      <span class="key-hint" aria-hidden="true">⌘ K</span>
    </div>
    <div class="filters">
      <div class="filter-tabs" role="group" aria-label="Filtrar canciones">
        <button type="button" class="filter-tab is-active" data-filter="all" aria-pressed="true">Todas <span class="tab-count">{songs.length}</span></button>
        <button type="button" class="filter-tab" data-filter="favorites" aria-pressed="false">♡ Favoritas</button>
      </div>
      <label class="sr-only" for="artist-filter">Filtrar por artista</label>
      <select class="artist-select" id="artist-filter"><option value="">Todos los artistas</option>
        {artists.map(artist => <option value={artist}>{artist}</option>)}
      </select>
    </div>
    <div class="active-list-line"><span id="active-list-label"></span><button type="button" id="clear-list-filter" hidden>Mostrar todas ×</button></div>
    <div class="list-heading"><span>CANCIONES</span><span id="result-count" aria-live="polite">{songs.length} resultados</span></div>
    <div class="song-list" id="song-list">
      {songs.map((song, index) => (
        <article class="song-card" data-id={song.id}>
          <a class="song-card-main" href={base + 'songs/' + encodeURIComponent(song.id) + '/'}>
            <span class="song-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="song-details"><strong>{song.data.title}</strong><span>{song.data.artist}</span></span>
            <span class="card-arrow" aria-hidden="true">↗</span>
          </a>
          <button type="button" class="song-list-button" data-manage-lists={song.id} data-song-title={song.data.title} aria-label={'Agregar ' + song.data.title + ' a listas'} title="Agregar a listas">+ Lista</button>
          <button type="button" class="favorite-button" data-favorite={song.id} aria-label={'Agregar ' + song.data.title + ' a favoritas'} aria-pressed="false" title="Guardar como favorita">♡</button>
        </article>
      ))}
    </div>
    <div class="empty-state" id="empty-state" hidden><span aria-hidden="true">♫</span><strong>No encontramos canciones</strong><p>Probá otro término o cambiá los filtros.</p></div>
    <div class="library-note"><span aria-hidden="true">✳</span> Instalá Cantario desde tu navegador para tener tu biblioteca disponible sin conexión después de la primera carga.</div>
  </section>
</main>
<footer class="footer"><span>cantario<span class="brand-dot">.</span></span><span>Canciones para llevar, cantar y compartir.</span></footer>
<script define:vars={{searchIndex}}>
  const input = document.getElementById('search');
  const artistSelect = document.getElementById('artist-filter');
  const tabs = [...document.querySelectorAll('[data-filter]')];
  const cards = [...document.querySelectorAll('.song-card')];
  const count = document.getElementById('result-count');
  const empty = document.getElementById('empty-state');
  const connection = document.getElementById('connection');
  const KEY = 'cantario:favorites:v1';
  const normalize = value => String(value ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase();
  let favorites;
  try { favorites = new Set(JSON.parse(localStorage.getItem(KEY) || '[]')); } catch { favorites = new Set(); }
  let filter = 'all';
  let activeListSongIds = null;
  window.addEventListener('cantario:list-filter', event => {
    activeListSongIds = event.detail.songIds;
    draw();
  });
  const songMap = new Map(searchIndex.map(song => [song.id, song]));
  function draw() {
    const query = normalize(input.value.trim());
    const artist = artistSelect.value;
    let visible = 0;
    for (const card of cards) {
      const song = songMap.get(card.dataset.id);
      const searchable = normalize([song.title, song.artist, song.language, song.tags.join(' '), song.body].join(' '));
      const show = (!query || searchable.includes(query)) && (!artist || artist === song.artist) &&
        (filter !== 'favorites' || favorites.has(song.id)) &&
        (activeListSongIds === null || activeListSongIds.includes(song.id));
      card.hidden = !show;
      if (show) visible++;
      const button = card.querySelector('[data-favorite]');
      const selected = favorites.has(song.id);
      button.textContent = selected ? '♥' : '♡';
      button.setAttribute('aria-pressed', String(selected));
      button.setAttribute('aria-label', (selected ? 'Quitar ' : 'Agregar ') + song.title + (selected ? ' de favoritas' : ' a favoritas'));
    }
    count.textContent = visible + (visible === 1 ? ' resultado' : ' resultados');
    empty.hidden = visible !== 0;
  }
  input.addEventListener('input', draw);
  artistSelect.addEventListener('change', draw);
  tabs.forEach(tab => tab.addEventListener('click', () => {
    filter = tab.dataset.filter;
    tabs.forEach(button => {
      const selected = button.dataset.filter === filter;
      button.classList.toggle('is-active', selected);
      button.setAttribute('aria-pressed', String(selected));
    });
    draw();
  }));
  document.querySelectorAll('[data-favorite]').forEach(button =>
    button.addEventListener('click', () => {
      const id = button.dataset.favorite;
      if (favorites.has(id)) favorites.delete(id); else favorites.add(id);
      try { localStorage.setItem(KEY, JSON.stringify([...favorites])); } catch {}
      draw();
    })
  );
  function updateConnection() {
    if (!connection) return;
    connection.classList.toggle('is-offline', !navigator.onLine);
    connection.querySelector('.connection-label').textContent = navigator.onLine ? 'Tu biblioteca, siempre cerca' : 'Estás sin conexión';
  }
  window.addEventListener('online', updateConnection);
  window.addEventListener('offline', updateConnection);
  updateConnection();
  document.addEventListener('keydown', event => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault(); input.focus();
    }
  });
  draw();
</script>
<dialog id="song-lists-dialog" class="lists-dialog" aria-labelledby="manage-song-title">
  <form method="dialog" class="dialog-header"><h3 id="manage-song-title">Agregar a listas</h3><button type="submit" class="close-dialog" aria-label="Cerrar">✕</button></form>
  <p class="dialog-intro">Marcá todas las listas donde querés guardar esta canción. Los cambios se conservan en este dispositivo.</p>
  <div id="song-lists-options" class="song-lists-options"></div>
  <form id="modal-new-list-form" class="create-list-form">
    <label class="sr-only" for="modal-list-name">Nombre de nueva lista</label>
    <input id="modal-list-name" name="name" maxlength="60" placeholder="Nueva lista…" required />
    <button type="submit" class="create-list-button">+ Crear y agregar</button>
  </form>
</dialog>
<script type="module" src={base + 'scripts/lists-ui.js'}></script>
</BaseLayout>
