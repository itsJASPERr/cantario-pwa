---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InstallApp from '../../components/InstallApp.astro';
import { ArrowLeft, ChevronDown, Minus, Moon, Plus, SlidersHorizontal, Sun, X } from '@lucide/astro';
import { hasChordTokens } from '../../lib/rehype-chords.mjs';
import { inspectSongTiming } from '../../lib/song-timing.mjs';
export async function getStaticPaths() {
  const songs = await getCollection('songs');
  return songs.map(song => ({params:{slug:song.id},props:{song}}));
}
interface Props { song: CollectionEntry<'songs'> }
const {song} = Astro.props;
const {Content} = await render(song);
const hasChords = hasChordTokens(song.body || '');
const timing = inspectSongTiming(song.body || '', song.data.duration_mmss || song.data.duration_seconds);
const formatTime = (seconds: number) => String(Math.floor(seconds / 60)).padStart(2,'0') + ':' + String(Math.floor(seconds % 60)).padStart(2,'0');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cmsSongs = 'https://app.pagescms.org/itsJASPERr/cantario-pwa/main/collection/songs';
const editSongUrl = cmsSongs + '/edit/' + encodeURIComponent('src/content/songs/' + song.id + '.md');
const newSongUrl = cmsSongs + '/new';
const isWebUrl = (value: unknown): value is string => {
  if (typeof value !== 'string' || !value.trim()) return false;
  try { const url = new URL(value); return url.protocol === 'https:' || url.protocol === 'http:'; }
  catch { return false; }
};
const links = [
  {label: 'Spotify', url: song.data.spotify_url},
  {label: 'YouTube', url: song.data.youtube_url},
  {label: 'Shazam', url: song.data.shazam_url}
].filter((link): link is {label:string;url:string} => isWebUrl(link.url));
const rawFiles = Array.isArray(song.data.recordings) ? song.data.recordings : (song.data.recordings ? [song.data.recordings] : []);
const recordings = rawFiles.filter(file => {
  if (typeof file !== 'string' || !file.startsWith(base + 'media/recordings/')) return false;
  try {
    const url = new URL(file, Astro.url);
    return url.origin === Astro.url.origin && !decodeURIComponent(url.pathname).includes('..');
  } catch { return false; }
});
const publishedForSong = (await getCollection('lists')).filter(list => list.data.songs.includes(song.id));
---
<BaseLayout title={song.data.title} description={'Letra de ' + song.data.title + ' — ' + song.data.artist + '. Disponible sin conexión en Cantario.'}>
  <header class="topbar topbar-reading">
    <a class="brand" href={base} aria-label="Cantario, inicio">
      <img src={base + 'icon.svg'} alt="" width="42" height="42" />
      <span class="brand-copy"><strong>cantario<span class="brand-dot">.</span></strong><small>tu cancionero vivo</small></span>
    </a>
    <div class="topbar-actions topbar-reading-actions">
      <a href={base} class="back-link">← Biblioteca</a>
      <InstallApp />
    </div>
  </header>
  <main class="reader">
    <a class="breadcrumb" href={base}>← Volver a las canciones</a>
    <section class="reader-top">
      <span class="eyebrow eyebrow-olive">UNA CANCIÓN PARA LLEVAR</span>
      <h1>{song.data.title}</h1><p>{song.data.artist}</p>
      {song.data.tags && song.data.tags.length > 0 && <div class="reader-tags">{song.data.tags.map(tag => <span>{tag}</span>)}</div>}
    </section>
    {(links.length > 0 || recordings.length > 0) && <section class="song-media" aria-label="Escuchar esta canción">
      <div class="song-media-heading"><span class="eyebrow eyebrow-olive">ESCUCHÁ ESTA CANCIÓN</span><h2>Escuchar y acompañar</h2></div>
      {links.length > 0 && <div class="song-platform-links">
        {links.map(link => <a class="song-platform-link" href={link.url} target="_blank" rel="noopener noreferrer">
          <span>{link.label}</span><span aria-hidden="true">↗</span>
        </a>)}
      </div>}
      {recordings.length > 0 && <div class="recordings-list">
        {recordings.map((path,idx) => <div class="recording-item" data-recording={path}>
          <div class="recording-header"><strong>Grabación {idx+1}</strong><a href={path} download>Descargar archivo ↗</a></div>
          <audio controls preload="none" src={path} aria-label={'Grabación ' + (idx+1) + ' de ' + song.data.title}>Tu navegador no soporta audio.</audio>
          <div class="recording-offline-control">
            <button type="button" data-cache-recording>Guardar sin conexión</button>
            <span data-recording-status aria-live="polite">Podés guardar este archivo para escucharlo sin internet.</span>
          </div>
        </div>)}
      </div>}
    </section>}
    {publishedForSong.length > 0 && <p class="reader-published-lists">Listas publicadas: {publishedForSong.map(list => list.data.title).join(' · ')}</p>}
    <nav class="reader-editor-actions" aria-label="Gestionar canción en Pages CMS">
      <a class="song-edit-link song-edit-primary" href={editSongUrl} target="_blank" rel="noopener noreferrer">Editar canción <span aria-hidden="true">↗</span></a>
      <a class="song-create-link" href={newSongUrl} target="_blank" rel="noopener noreferrer">+ Nueva canción</a>
    </nav>
    <div class="performance-launch-row">
      <button type="button" id="performance-enter" class="performance-launch" aria-haspopup="dialog">
        <span aria-hidden="true">▶</span>
        <span>Modo Escenario</span>
        <span class="performance-launch-note">Lectura automática y manos libres</span>
      </button>
    </div>
    <section class="reader-controls" aria-label="Opciones de lectura">
      <div class="reader-list-actions"><button type="button" class="song-list-button" data-manage-lists={song.id} data-song-title={song.data.title}>+ Agregar a listas</button>
      <button type="button" id="favorite" class="reader-favorite" aria-pressed="false"><span id="favorite-heart">♡</span> <span id="favorite-label">Guardar favorita</span></button></div>
      <div class="font-controls"><span>Tamaño de letra</span>
        <button type="button" id="font-down" aria-label="Reducir tamaño de letra">A−</button>
        <button type="button" id="font-up" aria-label="Aumentar tamaño de letra">A+</button>
      </div>
    </section>
    {hasChords && <div class="chord-view-toolbar">
      <span class="chord-view-label">Ver canción</span>
      <div class="chord-view-options" role="group" aria-label="Mostrar u ocultar acordes">
        <button type="button" id="chord-view-lyrics" aria-pressed="false">Letra</button>
        <button type="button" id="chord-view-chords" class="is-active" aria-pressed="true">Letra + acordes</button>
      </div>
    </div>}
    <article class="lyrics-paper" aria-label="Letra de la canción">
      <div class={'lyrics' + (hasChords ? ' show-chords' : '')} id="lyrics"><Content /></div>
      <div class="endmark" aria-hidden="true">✳</div>
    </article>
    <div class="reader-bottom"><a href={base}>← Volver al cancionero</a></div>
  </main>
  <footer class="footer"><span>cantario<span class="brand-dot">.</span></span><span>Un hogar para las canciones que nos acompañan.</span></footer>
  <script define:vars={{songId: song.id}}>
    const favoriteButton = document.getElementById('favorite');
    const favoriteHeart = document.getElementById('favorite-heart');
    const favoriteLabel = document.getElementById('favorite-label');
    const lyrics = document.getElementById('lyrics');
    const KEY = 'cantario:favorites:v1';
    const SIZE_KEY = 'cantario:font-size:v1';
    const CHORDS_KEY = 'cantario:chords-visible:v1';
    const lyricsMode = document.getElementById('chord-view-lyrics');
    const chordsMode = document.getElementById('chord-view-chords');
    function setChordVisibility(show) {
      lyrics.classList.toggle('show-chords', show);
      if (lyricsMode && chordsMode) {
        lyricsMode.classList.toggle('is-active', !show);
        lyricsMode.setAttribute('aria-pressed', String(!show));
        chordsMode.classList.toggle('is-active', show);
        chordsMode.setAttribute('aria-pressed', String(show));
      }
      try { localStorage.setItem(CHORDS_KEY, show ? 'yes' : 'no'); } catch {}
    }
    if (lyricsMode && chordsMode) {
      let saved = null;
      try { saved = localStorage.getItem(CHORDS_KEY); } catch {}
      setChordVisibility(saved !== 'no');
      lyricsMode.addEventListener('click', () => setChordVisibility(false));
      chordsMode.addEventListener('click', () => setChordVisibility(true));
    }
    let favorites;
    try { favorites = new Set(JSON.parse(localStorage.getItem(KEY) || '[]')); } catch { favorites = new Set(); }
    const syncFavorite = () => {
      const selected = favorites.has(songId);
      favoriteButton.setAttribute('aria-pressed', String(selected));
      favoriteHeart.textContent = selected ? '♥' : '♡';
      favoriteLabel.textContent = selected ? 'Guardada en favoritas' : 'Guardar favorita';
    };
    favoriteButton.addEventListener('click', () => {
      if (favorites.has(songId)) favorites.delete(songId); else favorites.add(songId);
      try { localStorage.setItem(KEY, JSON.stringify([...favorites])); } catch {}
      syncFavorite();
    });
    syncFavorite();
    let fontSize = 20;
    try { fontSize = Math.min(32, Math.max(12, Number(localStorage.getItem(SIZE_KEY) || 20) || 20)); } catch {}
    function setSize(value) {
      fontSize = Math.min(32, Math.max(12, value));
      lyrics.style.setProperty('--lyric-size', String(fontSize) + 'px');
      try { localStorage.setItem(SIZE_KEY, String(fontSize)); } catch {}
    }
    document.getElementById('font-down').addEventListener('click', () => setSize(fontSize - 2));
    document.getElementById('font-up').addEventListener('click', () => setSize(fontSize + 2));
    window.addEventListener('cantario:performance:font', event => setSize(event.detail));
    window.addEventListener('cantario:performance:chords', event => setChordVisibility(Boolean(event.detail)));
    setSize(fontSize);
  </script>
<dialog id="song-lists-dialog" class="lists-dialog" aria-labelledby="manage-song-title">
  <form method="dialog" class="dialog-header"><h3 id="manage-song-title">Agregar a listas</h3><button type="submit" class="close-dialog" aria-label="Cerrar">✕</button></form>
  <p class="dialog-intro">Marcá todas las listas donde querés guardar esta canción. Los cambios se conservan en este dispositivo.</p>
  <div id="song-lists-options" class="song-lists-options"></div>
  <form id="modal-new-list-form" class="create-list-form">
    <label class="sr-only" for="modal-list-name">Nombre de nueva lista</label>
    <input id="modal-list-name" name="name" maxlength="60" placeholder="Nueva lista…" required />
    <button type="submit" class="create-list-button">+ Crear y agregar</button>
  </form>
</dialog>
<script type="module" src={base + 'scripts/lists-ui.js'}></script>
<script type="module" src={base + 'scripts/audio-offline.js'}></script>

<dialog class="performance-dialog" id="performance-dialog" aria-labelledby="performance-heading" aria-modal="true"
  data-duration-seconds={timing.durationSeconds ?? ''} data-timing-valid={timing.valid ? 'yes':'no'}
  data-reference-bpm={song.data.bpm ?? ''} data-song-id={song.id}>
  <div class="performance-shell">
    <header class="performance-header">
      <button type="button" class="performance-exit" id="performance-exit" aria-label="Salir del modo escenario">
        <ArrowLeft size={16} aria-hidden="true" /> Salir
      </button>
      <div class="performance-heading">
        <strong id="performance-heading">{song.data.title}</strong>
        <span>{song.data.artist}</span>
      </div>
      <div class="performance-beat-meter" id="performance-beat-meter" role="img" aria-label="Pulso visual de cuatro tiempos">
        {[1,2,3,4].map(beat => <span class="performance-beat" data-beat={beat} aria-hidden="true">{beat}</span>)}
      </div>
      <button type="button" class="performance-toggle-controls" id="performance-toggle-controls" aria-pressed="true" aria-label="Mostrar u ocultar los controles">Ocultar controles</button>
    </header>

    <!-- Floating overlay: does not resize or move the lyrics as cues change. -->
    <div class="performance-live-cue" id="performance-live-cue" role="group"
      aria-label="Indicación de entrada musical" aria-live="off" hidden>
      <span class="performance-cue-label" id="performance-cue-label"></span>
      <strong class="performance-cue-value" id="performance-cue-value"></strong>
      <span class="performance-cue-detail" id="performance-cue-detail"></span>
    </div>

    <section class="performance-scroll" id="performance-scroll" tabindex="0" aria-label="Letra de la canción en modo escenario. Deslizá para pausar el desplazamiento automático.">
      <div class="performance-lead">
        <p>♫ CANTARIO · MODO ESCENARIO</p>
        <h2>{song.data.title}</h2>
        <span>{song.data.artist}</span>
      </div>
      <article class="performance-lyrics-area" aria-label="Letra para cantar">
        <div id="performance-lyrics" class={'lyrics' + (hasChords ? ' show-chords' : '')}><Content /></div>
      </article>
      <div class="performance-endmark" id="performance-endmark" aria-hidden="true">✳</div>
      <div class="performance-tail" aria-hidden="true"></div>
    </section>

    <footer class="performance-controls" aria-label="Controles de escenario">
      <div class="performance-compact-bar">
      <div class="performance-status">
        <span id="performance-status" aria-live="polite">Listo para cantar</span>
        <span id="performance-bpm-mini" class="performance-bpm-mini">80 BPM</span>
        <span id="performance-progress" aria-live="off">0%</span>
      </div>
      <p id="performance-no-scroll" class="performance-no-scroll" hidden>La canción cabe en la pantalla. No necesitás desplazamiento automático.</p>
      <div class="performance-play-row">
        <button type="button" class="performance-speed-button" id="performance-slower" aria-label="Disminuir tempo en BPM"><Minus size={22} aria-hidden="true" /></button>
        <button type="button" class="performance-play" id="performance-play">▶ Iniciar</button>
        <button type="button" class="performance-speed-button" id="performance-faster" aria-label="Aumentar tempo en BPM"><Plus size={22} aria-hidden="true" /></button>
      </div>
      <button type="button" id="performance-settings-toggle" class="performance-settings-toggle"
        aria-expanded="false" aria-controls="performance-settings" aria-label="Abrir ajustes de escenario" title="Ajustes de escenario">
        <SlidersHorizontal size={21} aria-hidden="true" />
      </button>
      </div>
      <div class="performance-settings" id="performance-settings" aria-label="Ajustes de escenario">
        <div class="performance-settings-heading">
          <strong>Ajustes de escenario</strong>
          <button type="button" id="performance-settings-close" aria-label="Cerrar ajustes"><X size={20} aria-hidden="true" /></button>
        </div>
      <div class="performance-mode-selector" id="performance-mode-wrap" hidden={!timing.valid}>
        <label for="performance-mode">Desplazamiento</label>
        <span class="performance-duration-wrap">
          <select id="performance-mode" aria-label="Modo de desplazamiento">
            <option value="continuous">Continuo</option>
            <option value="timed">Sincronizado</option>
          </select>
          <ChevronDown class="performance-duration-chevron" size={17} aria-hidden="true" />
        </span>
      </div>
      <p id="performance-timed-description" class="performance-timed-description" hidden={!timing.valid}>
        Sigue la referencia de <strong>{timing.durationSeconds ? formatTime(timing.durationSeconds) : ''}</strong>
        y las marcas de inicio de cada línea. Ajustá −/+ si cambia el ritmo en vivo.
      </p>
      <div class="performance-timing" id="performance-continuous-duration">
        <label for="performance-duration">Duración</label>
        <span class="performance-duration-wrap">
        <select id="performance-duration" aria-label="Duración aproximada de desplazamiento">
          <option value="60">1:00</option>
          <option value="90">1:30</option>
          <option value="120">2:00</option>
          <option value="150">2:30</option>
          <option value="180">3:00</option>
          <option value="210" selected>3:30</option>
          <option value="240">4:00</option>
          <option value="270">4:30</option>
          <option value="300">5:00</option>
          <option value="360">6:00</option>
          <option value="420">7:00</option>
          <option value="480">8:00</option>
          <option value="600">10:00</option>
          <option value="900">15:00</option>
          <option value="1200">20:00</option>
          <option value="1800">30:00</option>
        </select>
        <ChevronDown class="performance-duration-chevron" size={17} aria-hidden="true" />
        </span>
        <span class="performance-speed-label">Ritmo <strong id="performance-speed">80 BPM</strong></span>
      </div>
      <div class="performance-tempo-panel" role="group" aria-label="Ritmo en pulsos por minuto">
        <div class="performance-tempo-heading">
          <span>Ritmo</span>
          <strong id="performance-tempo-value">80 BPM</strong>
        </div>
        <p id="performance-tempo-hint">BPM guía. Podés marcar el pulso si no conocés el tempo.</p>
        <button type="button" class="performance-tap-tempo" id="performance-tap-tempo">Marcar pulso</button>
        <small id="performance-tap-status" role="status" aria-live="polite">Tocá 4 veces al ritmo de la canción.</small>
      </div>
      <div class="performance-extras">
        <div class="performance-font-row" role="group" aria-label="Tamaño de letra">
          <button type="button" id="performance-font-down" aria-label="Reducir tamaño de letra">A−</button>
          <button type="button" id="performance-font-up" aria-label="Aumentar tamaño de letra">A+</button>
        </div>
        <button type="button" id="performance-chords" aria-pressed="true" disabled={!hasChords} hidden={!hasChords}>♫ Acordes: sí</button>
        <button type="button" id="performance-countdown" aria-pressed="true">◷ Inicio: 3 s</button>
        <button type="button" id="performance-wake" class="performance-wake-button" aria-pressed="true" aria-label="Keep awake: prevent screen locking during performance" title="Keep awake: prevents the screen from locking during a performance when supported">
          <Sun class="wake-icon-on" size={16} aria-hidden="true" />
          <Moon class="wake-icon-off" size={16} aria-hidden="true" />
          <span id="performance-wake-label">Keep awake · …</span>
        </button>
      </div>
      </div>
    </footer>
  </div>
</dialog>
<script type="module" src={base + 'scripts/performance.js'}></script>
</BaseLayout>
