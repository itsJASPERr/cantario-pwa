---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'Cantario', description = 'Tu cancionero vivo. Canciones para llevar, cantar y compartir.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fullTitle = title === 'Cantario' ? 'Cantario · Tu cancionero vivo' : title + ' · Cantario';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#253d31" />
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Cantario" />
  <link rel="icon" type="image/svg+xml" href={base + 'icon.svg'} />
  <link rel="apple-touch-icon" href={base + 'icons/apple-touch-icon.png'} />
  <title>{fullTitle}</title>
</head>
<body><div class="app-shell"><slot /></div></body>
</html>
